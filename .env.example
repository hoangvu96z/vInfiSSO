# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# For development: localhost, for production: use RDS or managed database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=vinfi_sso
DATABASE_PASSWORD=your-secure-password-here
DATABASE_NAME=vinfi_sso

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Session / JWT ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=your-random-secret-string-min-32-chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=your-random-session-secret-min-32-chars

# ─── Reading encryption (required in every environment) ──────────────────────
# Generate a unique 32-byte key on a trusted machine with: openssl rand -base64 32
# Store the generated value in the server-only .env and a secret manager; never commit it.
# Keep every old key ID configured until its readings have been re-encrypted.
# Replace this placeholder with a real key before starting the application.
DATA_ENCRYPTION_KEYS=k1:<base64-encoded-32-byte-key>
DATA_ENCRYPTION_ACTIVE_KEY_ID=k1

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/sso/oauth/google/callback

# ─── Facebook OAuth ───────────────────────────────────────────────────────────
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/sso/oauth/facebook/callback

# ─── Email (SMTP Configuration) ────────────────────────────────────────────────
# Option 1: Local Postfix on VPS (no authentication needed)
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@vunph.click

# Option 2: Remote mail server with authentication
# MAIL_HOST=mail.vunph.click
# MAIL_PORT=587
# MAIL_USER=sso@vunph.click
# MAIL_PASSWORD=secure-password
# MAIL_FROM=noreply@vunph.click

# Option 3: Gmail SMTP (requires app password)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=your-email@gmail.com
# MAIL_PASSWORD=your-app-specific-password
# MAIL_FROM=your-email@gmail.com

# ─── URLs ─────────────────────────────────────────────────────────────────────
SSO_BASE_URL=http://localhost:3000
ICHINGNOW_URL=http://localhost:3001
TAROTNOW_URL=http://localhost:3002

# For production (sso.vunph.click):
# SSO_BASE_URL=https://sso.vunph.click
# APP_BASE_URL=http://localhost:5177
# Production NoteNow invite links use https://vunph.click.
# APP_BASE_URL=https://vunph.click
# Session cookies default to host-only on the SSO API host in every environment.
# Set a Domain only if the cookie must be sent to multiple sibling API hosts.
# App JavaScript cannot read this HttpOnly cookie; credentials: include sends the
# host-only cookie to sso.vunph.click for same-site app-to-API requests.
# SSO_COOKIE_DOMAIN=.vunph.click
# ICHINGNOW_URL=https://vunph.click/kinhdich
# TAROTNOW_URL=https://vunph.click/tarot
# TUVINOW_URL=https://vunph.click/tuvi
# TALKWITHME_URL=https://vunph.click/talkwithme
# CONTACT_NOTIFY_EMAIL=admin@vunph.id.vn

# ─── CORS (comma-separated, no trailing slash) ───────────────────────────────
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177

# For production:
# ALLOWED_ORIGINS=https://vunph.id.vn,https://www.vunph.id.vn,https://vunph.click,https://www.vunph.click
ALLOWED_REDIRECT_ORIGINS=https://vunph.id.vn,https://www.vunph.id.vn,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177
TRUST_PROXY=loopback

# AI proxy — server-side only, never use a VITE_ prefix for these settings.
# Prefer the local loopback endpoint after binding the AI service to localhost.
TUVI_AI_BASE_URL=http://43.128.116.69:20128/v1
TUVI_AI_API_KEY=
TUVI_AI_MODELS=combo1
